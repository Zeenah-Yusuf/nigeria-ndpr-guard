{
  "framework": {
    "id": "ndpa-2023",
    "name": "Nigeria Data Protection Act 2023",
    "version": "1.0",
    "agency": "Nigeria Data Protection Commission",
    "effective_date": "2023-06-12",
    "last_updated": "2025-09-19",
    "description": "Comprehensive data protection framework for all organizations processing personal data of Nigerian residents",
    "source_url": "https://ndpc.gov.ng/ndpa-2023",
    "applicable_sectors": ["all"],
    "dcpmi_tier": "varies",
    "supplementary_frameworks": ["GAID 2025"]
  },
  "obligations": [
    {
      "id": "ndpa-24",
      "category": "principles",
      "section": "Section 24",
      "requirement": "Lawful, Fair, and Transparent Processing",
      "description": "Personal data must be processed lawfully, fairly, and in a transparent manner. Processing must have a valid lawful basis.",
      "trigger_condition": "collectsData === true",
      "risk_weight": 12,
      "priority": "critical",
      "difficulty": "Medium",
      "time_estimate": "2-3 weeks",
      "evidence_required": ["Privacy policy", "Lawful basis documentation", "Processing records"],
      "remediation": "Document your lawful basis for processing and publish a clear privacy policy.",
      "penalty_non_compliance": "₦10,000,000 or 2% of annual gross revenue (Section 48)",
      "resources": [
        {
          "name": "NDPC Official Website",
          "url": "https://ndpc.gov.ng"
        },
        {
          "name": "NDPA 2023 Full Text",
          "url": "https://ndpc.gov.ng/ndpa-2023"
        }
      ],
      "cross_references": ["ndpa-25"]
    },
    {
      "id": "ndpa-25",
      "category": "lawful_basis",
      "section": "Section 25",
      "requirement": "Valid Lawful Basis for Processing",
      "description": "Processing is lawful only if at least one lawful basis applies: consent, contract, legal obligation, vital interests, public interest, or legitimate interests.",
      "trigger_condition": "collectsData === true",
      "risk_weight": 12,
      "priority": "critical",
      "difficulty": "Medium",
      "time_estimate": "1-2 weeks",
      "evidence_required": ["Lawful basis assessment", "Consent records (if applicable)", "Contract documentation"],
      "remediation": "Identify and document your lawful basis for each processing activity.",
      "penalty_non_compliance": "₦10,000,000 or 2% of annual gross revenue (Section 48)",
      "resources": [
        {
          "name": "NDPC Official Website",
          "url": "https://ndpc.gov.ng"
        },
        {
          "name": "NDPA 2023 Full Text",
          "url": "https://ndpc.gov.ng/ndpa-2023"
        }
      ],
      "cross_references": ["ndpa-26"]
    },
    {
      "id": "ndpa-26",
      "category": "consent",
      "section": "Section 26",
      "requirement": "Explicit and Informed Consent",
      "description": "Consent must be freely given, specific, informed, and unambiguous. Silence, pre-ticked boxes, or inactivity do not constitute consent. Consent can be withdrawn at any time.",
      "trigger_condition": "hasConsentMechanism === false",
      "risk_weight": 14,
      "priority": "critical",
      "difficulty": "Medium",
      "time_estimate": "2-3 weeks",
      "evidence_required": ["Consent records", "Consent withdrawal mechanism", "Privacy notice"],
      "remediation": "Implement explicit opt-in consent mechanisms with clear records of when and how consent was obtained.",
      "penalty_non_compliance": "₦10,000,000 or 2% of annual gross revenue (Section 48)",
      "resources": [
        {
          "name": "NDPC Official Website",
          "url": "https://ndpc.gov.ng"
        },
        {
          "name": "NDPA 2023 Full Text",
          "url": "https://ndpc.gov.ng/ndpa-2023"
        }
      ],
      "cross_references": ["ndpa-35"]
    },
    {
      "id": "ndpa-27",
      "category": "transparency",
      "section": "Section 27",
      "requirement": "Privacy Policy Publication",
      "description": "Data controllers must publish a privacy policy that clearly explains what data is collected, how it's processed, who it's shared with, and data subject rights.",
      "trigger_condition": "hasPrivacyPolicy === false",
      "risk_weight": 10,
      "priority": "critical",
      "difficulty": "Easy",
      "time_estimate": "1-3 days",
      "evidence_required": ["Published privacy policy URL", "Privacy policy document"],
      "remediation": "Create and publish a comprehensive privacy policy on your website and app.",
      "penalty_non_compliance": "₦5,000,000",
      "resources": [
        {
          "name": "NDPC Official Website",
          "url": "https://ndpc.gov.ng"
        },
        {
          "name": "NDPC Resources Page",
          "url": "https://ndpc.gov.ng/resources"
        }
      ],
      "cross_references": []
    },
    {
      "id": "ndpa-28",
      "category": "risk_assessment",
      "section": "Section 28",
      "requirement": "Data Protection Impact Assessment",
      "description": "A DPIA is required prior to processing that may result in high risk to data subjects, including profiling, automated decisions, sensitive data, or new technologies.",
      "trigger_condition": "usesAI === true || sensitiveData === true",
      "risk_weight": 11,
      "priority": "high",
      "difficulty": "Hard",
      "time_estimate": "1-2 weeks",
      "evidence_required": ["DPIA report", "Risk mitigation plan", "Stakeholder consultation records"],
      "remediation": "Conduct a formal DPIA documenting risks and mitigations before starting high-risk processing.",
      "penalty_non_compliance": "₦8,000,000",
      "resources": [
        {
          "name": "NDPC Official Website",
          "url": "https://ndpc.gov.ng"
        },
        {
          "name": "NDPA 2023 Full Text",
          "url": "https://ndpc.gov.ng/ndpa-2023"
        }
      ],
      "cross_references": ["ndpa-30", "ndpa-37"]
    },
    {
      "id": "ndpa-30",
      "category": "sensitive_data",
      "section": "Section 30",
      "requirement": "Sensitive Personal Data Protection",
      "description": "Processing of sensitive personal data (health, biometric, genetic, religious beliefs, political opinions, trade union membership, sexual orientation) is prohibited unless specific conditions apply.",
      "trigger_condition": "sensitiveData === true",
      "risk_weight": 16,
      "priority": "critical",
      "difficulty": "Hard",
      "time_estimate": "2-4 weeks",
      "evidence_required": ["Explicit consent records", "Necessity justification", "Enhanced security measures"],
      "remediation": "Obtain explicit consent and implement enhanced security measures for sensitive data.",
      "penalty_non_compliance": "₦10,000,000 or 2% of annual gross revenue (Section 48)",
      "resources": [
        {
          "name": "NDPC Official Website",
          "url": "https://ndpc.gov.ng"
        },
        {
          "name": "NDPA 2023 Full Text",
          "url": "https://ndpc.gov.ng/ndpa-2023"
        }
      ],
      "cross_references": ["ndpa-26", "ndpa-28"]
    },
    {
      "id": "ndpa-31",
      "category": "children",
      "section": "Section 31",
      "requirement": "Children's Data Protection",
      "description": "A child is any person under 18 years. Processing children's personal data requires verifiable parental consent.",
      "trigger_condition": "targetsChildren === true",
      "risk_weight": 15,
      "priority": "high",
      "difficulty": "Medium",
      "time_estimate": "1-2 weeks",
      "evidence_required": ["Age verification mechanism", "Parental consent records", "Child-friendly privacy notice"],
      "remediation": "Implement age verification and parental consent mechanisms for users under 18.",
      "penalty_non_compliance": "₦10,000,000",
      "resources": [
        {
          "name": "NDPC Official Website",
          "url": "https://ndpc.gov.ng"
        },
        {
          "name": "NDPA 2023 Full Text",
          "url": "https://ndpc.gov.ng/ndpa-2023"
        }
      ],
      "cross_references": ["ndpa-26"]
    },
    {
      "id": "ndpa-32",
      "category": "governance",
      "section": "Section 32",
      "requirement": "Data Protection Officer Appointment",
      "description": "Data Controllers of Major Importance must appoint a Data Protection Officer with expert knowledge of data protection law and practices.",
      "trigger_condition": "registeredWithNDPC === false || dcpmTier === 'UHL' || dcpmTier === 'EHL'",
      "risk_weight": 13,
      "priority": "high",
      "difficulty": "Medium",
      "time_estimate": "2-4 weeks",
      "evidence_required": ["DPO appointment letter", "DPO contact details", "DPO qualifications"],
      "remediation": "Designate a qualified Data Protection Officer and register with NDPC.",
      "penalty_non_compliance": "₦5,000,000",
      "resources": [
        {
          "name": "NDPC Official Website",
          "url": "https://ndpc.gov.ng"
        },
        {
          "name": "NDPC DPCO Directory",
          "url": "https://ndpc.gov.ng/dpco-directory"
        }
