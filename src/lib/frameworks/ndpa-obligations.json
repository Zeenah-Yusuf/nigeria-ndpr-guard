    {
      "id": "ndpa-40",
      "category": "breach",
      "section": "Section 40",
      "requirement": "72-Hour Breach Notification",
      "description": "Personal data breaches must be reported to NDPC within 72 hours of discovery. If breach poses high risk to data subjects, they must also be notified.",
      "trigger_condition": "hasBreachProcess === false",
      "risk_weight": 15,
      "priority": "critical",
      "difficulty": "Medium",
      "time_estimate": "1 week",
      "evidence_required": ["Breach response plan", "Breach notification template", "Incident log"],
      "remediation": "Establish breach detection and notification procedures with 72-hour NDPC reporting.",
      "penalty_non_compliance": "₦10,000,000",
      "resources": [
        {
          "name": "NDPC Official Website",
          "url": "https://ndpc.gov.ng"
        },
