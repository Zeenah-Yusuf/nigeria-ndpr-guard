    {
      "id": "ndpa-41",
      "category": "international",
      "section": "Sections 41-43",
      "requirement": "Cross-Border Data Transfer Safeguards",
      "description": "Transfer of personal data outside Nigeria requires adequate protection safeguards, such as adequacy decisions, binding corporate rules, or standard contractual clauses.",
      "trigger_condition": "crossBorderTransfer === true",
      "risk_weight": 11,
      "priority": "high",
      "difficulty": "Hard",
      "time_estimate": "2-4 weeks",
      "evidence_required": ["Transfer impact assessment", "SCCs or BCRs", "Recipient security assessment"],
      "remediation": "Implement Standard Contractual Clauses or obtain explicit consent for international transfers.",
      "penalty_non_compliance": "₦8,000,000",
