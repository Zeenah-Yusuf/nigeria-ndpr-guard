    },
    {
      "id": "ndpa-37",
      "category": "automation",
      "section": "Section 37",
      "requirement": "Automated Decision-Making Safeguards",
      "description": "Data subjects have the right not to be subject to solely automated decisions that produce legal effects or significantly affect them.",
      "trigger_condition": "usesAI === true",
      "risk_weight": 9,
      "priority": "high",
      "difficulty": "Hard",
      "time_estimate": "2-3 weeks",
      "evidence_required": ["Human intervention mechanism", "Algorithm explanation", "Opt-out mechanism"],
      "remediation": "Provide human intervention option and explain how automated decisions are made.",
      "penalty_non_compliance": "₦7,000,000",
      "resources": [
        {
          "name": "NDPC Official Website",
          "url": "https://ndpc.gov.ng"
        },
        {
          "name": "NDPA 2023 Full Text",
          "url": "https://ndpc.gov.ng/ndpa-2023"
        }
      ],
      "cross_references": ["ndpa-28"]
    },
    {
      "id": "ndpa-39",
      "category": "security",
      "section": "Section 39",
      "requirement": "Appropriate Security Measures",
      "description": "Implement appropriate technical and organizational measures to ensure security of personal data, including encryption, access controls, and regular testing.",
      "trigger_condition": "collectsData === true",
      "risk_weight": 14,
      "priority": "critical",
      "difficulty": "Hard",
      "time_estimate": "1-3 months",
      "evidence_required": ["Security policy", "Encryption evidence", "Access control logs", "Penetration test reports"],
      "remediation": "Implement encryption, access controls, and regular security assessments.",
      "penalty_non_compliance": "₦10,000,000 or 2% of annual gross revenue (Section 48)",
      "resources": [
        {
          "name": "NDPC Official Website",
          "url": "https://ndpc.gov.ng"
        },
        {
          "name": "NDPA 2023 Full Text",
          "url": "https://ndpc.gov.ng/ndpa-2023"
