{
  "name": "regtrack",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Multi-Framework Regulatory Compliance Simulator for Nigerian Startups - NDPA, CBN, SEC, NITDA",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "embeddings:generate": "node scripts/generate-embeddings.cjs",
    "embeddings:migrate": "node scripts/migrate-existing-data.js",
    "db:migrate": "supabase db push",
    "db:seed": "supabase db seed",
    "db:reset": "supabase db reset",
    "db:backup": "supabase db dump -f backup.sql",
    "functions:deploy": "supabase functions deploy scan search generate-report parse-document monitor-regulators generate-alerts",
    "functions:deploy:scan": "supabase functions deploy scan",
    "functions:deploy:search": "supabase functions deploy search",
    "functions:deploy:report": "supabase functions deploy generate-report",
    "functions:deploy:parse": "supabase functions deploy parse-document",
    "functions:deploy:monitor": "supabase functions deploy monitor-regulators",
    "functions:deploy:alerts": "supabase functions deploy generate-alerts",
    "setup:all": "npm run db:migrate && npm run db:seed && npm run embeddings:migrate && npm run embeddings:generate",
    "setup:db": "npm run db:migrate && npm run db:seed",
    "setup:embeddings": "npm run embeddings:generate",
    "deploy:all": "npm run functions:deploy"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-query": "^5.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.344.0",
    "next-themes": "^0.4.6",
    "openai": "^4.28.0",
    "radix-ui": "^1.4.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "dotenv": "^16.4.1",
    "eslint": "^8.56.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
