# Supabase Configuration (Frontend - Safe to expose)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Azure Functions Backend URL
VITE_AZURE_FUNCTION_URL=http://localhost:7071/api

# Azure OpenAI (For local embedding generation script only)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Supabase Service Role Key (For scripts only - NEVER use in frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here